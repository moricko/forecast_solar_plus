# Parametre pre skript tools/fetch_test.py (test API mimo Home Assistant).
# Skopíruj do .env a doplň vlastné hodnoty. Súbor .env je v .gitignore.

# Voliteľný API kľúč Forecast.Solar (prázdne = verejný prístup, 12 volaní/h, hodinové rozlíšenie)
FORECAST_SOLAR_API_KEY=

# Poloha
FORECAST_SOLAR_LAT=48.1500
FORECAST_SOLAR_LON=17.1100

# Plochy: sklon/azimut/kWp oddelené dvojbodkou, viac plôch oddelených čiarkou
# Azimut: -90 = východ, 0 = juh, 90 = západ
FORECAST_SOLAR_PLANES=35:-90:5.0,35:90:5.0

# Voliteľný limit striedača v kW (0 = bez limitu)
FORECAST_SOLAR_INVERTER_KW=0
